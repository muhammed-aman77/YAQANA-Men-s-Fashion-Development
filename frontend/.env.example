# Keep the API same-origin. Vite proxies local requests and Vercel rewrites staging requests to Render.
VITE_API_BASE_URL=/api
VITE_AUTH_MODE=bearer

# Set VITE_AUTH_MODE=cookie in Vercel Preview only when the Render backend has
# AUTH_COOKIE_ENABLED=true. Keep the frontend and API on the same Vercel origin.
