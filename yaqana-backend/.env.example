NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/yaqana_local_dev_20261115
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=86400
# Generate a stable local value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the real value in the untracked local .env file; never commit it or change it after MFA enrollment.
MFA_ENCRYPTION_KEY=
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false
AUTH_COOKIE_ENABLED=false
REQUIRE_MONGO_TRANSACTIONS=false
MEDIA_STORAGE=local
LOG_LEVEL=info
# Dummy catalogue seeding requires explicit local opt-in and an exact staging seed-host allowlist.
DUMMY_CATALOG_SEED_ENABLED=false
DUMMY_CATALOG_EXPECTED_MONGODB_HOSTS=
# Product-image uploads require these server-side credentials only when MEDIA_STORAGE=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary compatibility settings matching the current storefront calculations. Replace after the pricing UI is updated.
LEGACY_CURRENCY_FACTOR=83
LEGACY_SHIPPING_THRESHOLD=200
LEGACY_SHIPPING_FEE=15
LEGACY_TAX_RATE=0.08
